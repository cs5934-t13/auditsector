# 1. Generate TWO values: a MySQL root password and a Flask session key
#      Flask key: openssl rand -hex 32
# 2. Encode each with `printf '%s' <value> | base64`  (NOT `echo` -- echo adds a
#    trailing newline, which becomes part of the password and will not match the
#    value MySQL was initialised with).
# 3. Replace the two BASE 64 ENCODED PASSWORD placeholders below.
# 4. Save this file as 'secrets.yaml' (it is gitignored).
# 5. podman kube play secrets.yaml, then verify with `podman secret ls`:
#    BOTH mysql_root_password and flask_secret_key must be listed. If a
#    placeholder is left un-replaced, only one secret is created and the server
#    exits with KeyError: 'FLASK_SECRET_KEY'.

apiVersion: v1
kind: Secret
metadata:
  name: mysql-root-password
type: Opaque
data:
  mysql_password: BASE 64 ENCODED PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: flask-secret-key
type: Opaque
data:
  secret_key: BASE 64 ENCODED PASSWORD
---
apiVersion: v1
kind: Secret
metadata:
  name: llm-api
type: Opaque
stringData:
  llm_api_url: YOUR API URL
  llm_api_key: YOUR API KEY

